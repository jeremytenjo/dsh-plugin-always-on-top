{
  "name": "dsh-plugin-always-on-top",
  "version": "1.0.2",
  "private": false,
  "type": "module",
  "description": "Pin the DeepSeek Harness desktop window above every other app from a button beside source control.",
  "license": "MIT",
  "author": "Jeremy Tenjo",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "always-on-top",
    "window",
    "pin",
    "macos"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeremytenjo/dsh-plugin-always-on-top.git"
  },
  "homepage": "https://github.com/jeremytenjo/dsh-plugin-always-on-top#readme",
  "bugs": {
    "url": "https://github.com/jeremytenjo/dsh-plugin-always-on-top/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs",
    "scripts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "react": "18.3.1"
  }
}
